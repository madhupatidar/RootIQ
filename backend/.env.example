DATABASE_URL=postgresql://postgres:admin@127.0.0.1:5432/RootIQ


# ── Ollama / LLM ────────────────────────────────────────────
# Hosted Ollama Cloud (key from https://ollama.com/settings/keys):
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

# Local daemon instead — leave OLLAMA_API_KEY blank:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

OLLAMA_TIMEOUT_SECONDS=180

CORS_ORIGINS=http://localhost:5173
